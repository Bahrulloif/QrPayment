@model QrPaymentWeb.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Информация о платеже";
}

<div class="payment-container">
    <div class="payment-card">

        <div class="payment-logo">
            <h2>QR Payment</h2>
        </div>

        <div class="payment-info">
            <p class="info-label">Получатель платежа</p>
            <h3>@Model.Recipient</h3>

            <p class="info-label">Сумма к оплате</p>
            <div class="payment-amount">
                @Model.Amount.ToString("N2") @Model.Currency
            </div>
        </div>

        <div class="payment-actions">

            <p class="download-title">
                Для оплаты используйте приложение Tcell или Paykar.
            </p>

            <p class="download-subtitle">
                Если приложение ещё не установлено, скачайте его:
            </p>

            
            <div class="store-links">

                <!-- Ссылки для Android -->
                <div class="store-platform" id="androidLinks">
                    <h4>Для Android</h4>

                    <a href="https://play.google.com/store/apps/details?id=tj.tcell.odp" target="_blank"
                       rel="noopener noreferrer">
                        Скачать Tcell
                    </a>

                    <a href="https://play.google.com/store/apps/details?id=tj.paykar.shop" target="_blank"
                       rel="noopener noreferrer">
                        Скачать Paykar
                    </a>
                </div>

                <!-- Ссылки для iOS -->
                <div class="store-platform" id="iosLinks">
                    <h4>Для iPhone и iPad</h4>

                    <a href="https://apps.apple.com/ru/app/%D0%BC%D0%BE%D0%B9-tcell/id966493756" target="_blank"
                       rel="noopener noreferrer">
                        Скачать Tcell
                    </a>

                    <a href="https://apps.apple.com/ru/app/paykar/id1662197787" target="_blank"
                       rel="noopener noreferrer">
                        Скачать Paykar
                    </a>
                </div>

            </div>

            <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const userAgent = navigator.userAgent || "";

                                const isAndroid = /Android/i.test(userAgent);
                                const isIOS = /iPhone|iPad|iPod/i.test(userAgent);

                                const androidLinks = document.getElementById("androidLinks");
                                const iosLinks = document.getElementById("iosLinks");

                                if (isAndroid) {
                                    androidLinks.style.display = "flex";
                                    iosLinks.style.display = "none";
                                }
                                else if (isIOS) {
                                    androidLinks.style.display = "none";
                                    iosLinks.style.display = "flex";
                                }
                                else {
                                    androidLinks.style.display = "flex";
                                    iosLinks.style.display = "flex";
                                }
                            });
            </script>

        </div>

    </div>
</div>
