@model QrPaymentWeb.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Информация о платеже";
}

<div class="payment-container">

    <div class="payment-card">

        <div class="payment-logo">
            <h2>QR Payment</h2>
        </div>

        <div class="payment-info">

            <p class="info-label">Получатель платежа</p>

            <h3>@Model.Recipient</h3>

            <p class="info-label">Сумма к оплате</p>

            <div class="payment-amount">
                @Model.Amount.ToString("N2") @Model.Currency
            </div>

        </div>

        <div class="payment-actions">

            <a href="#" class="btn-open-app">
                Открыть в приложении
            </a>

            <p class="download-title">
                Нет приложения? Скачайте его:
            </p>

            <div class="store-links">

                <a href="https://apps.apple.com/ru/app/paykar/id1662197787" target="_blank">
                    App Store
                </a>

                <a href="https://play.google.com/store/apps/details?id=tj.tcell.odp&pcampaignid=web_share"
                   target="_blank">
                    Tcell
                </a>
                <a href="https://play.google.com/store/apps/details?id=tj.paykar.shop&hl=ru" target="_blank">
                    Paykar
                </a>

            </div>

        </div>

    </div>

</div>
